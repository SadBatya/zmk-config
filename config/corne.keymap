 *
 * Layer 0: BASE
 * Layer 1: EDIT
 * Layer 2: CLIP
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        // Save project, then open Export dialog
        save_export: save_export {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <100>;
            tap-ms = <40>;
            bindings =
                <&kp LC(S)>,
                <&kp LC(E)>;
        };

        // Undo twice
        undo_twice: undo_twice {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <60>;
            tap-ms = <40>;
            bindings =
                <&kp LC(Z)>,
                <&kp LC(Z)>;
        };

        // Redo twice
        redo_twice: redo_twice {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <60>;
            tap-ms = <40>;
            bindings =
                <&kp LC(LS(Z))>,
                <&kp LC(LS(Z))>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // =========================================================
        // LAYER 0 — BASE
        // =========================================================

        default_layer {
            display-name = "BASE";

            bindings = <
                // TAB  Q    W    E    R    T       Y    U    I    O    P    BSPC
                &kp TAB    &kp Q &kp W &kp E &kp R &kp T
                &kp Y      &kp U &kp I &kp O &kp P &kp BSPC

                // CTRL A    S    D    F    G       H    J    K    L    ;    '
                &kp LCTRL  &kp A &kp S &kp D &kp F &kp G
                &kp H      &kp J &kp K &kp L &kp SEMI &kp SQT

                // SHIFT Z  X    C    V    B       N    M    ,    .    /    ESC
                &kp LSHFT  &kp Z &kp X &kp C &kp V &kp B
                &kp N      &kp M &kp COMMA &kp DOT &kp FSLH &kp ESC

                // GUI | EDIT | SPACE       ENTER | CLIP | ALT
                &kp LGUI &mo 1 &kp SPACE
                &kp RET  &mo 2 &kp RALT
            >;
        };

        // =========================================================
        // LAYER 1 — EDIT
        // Основные команды монтажа
        // =========================================================

        lower_layer {
            display-name = "EDIT";

            bindings = <
                // UNDO | REDO | SPLIT | TRIM LEFT | TRIM RIGHT | DELETE
                &kp LC(Z) &kp LC(LS(Z)) &kp LC(B) &kp Q &kp W &kp DEL

                // LEFT | DOWN | UP | RIGHT | PLAY | MARKER
                &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp SPACE &kp M

                // COPY | CUT | PASTE | DUPLICATE | GROUP | UNGROUP
                &kp LC(C) &kp LC(X) &kp LC(V) &kp LC(D) &kp LC(G) &kp LC(LS(G))

                // SELECT | SPLIT TOOL | ENABLE | MAGNET | SNAP | PREVIEW
                &kp A &kp B &kp V &kp P &kp N &kp S

                // IN | OUT | SAVE | SAVE+EXPORT | UNDO X2 | REDO X2
                &kp I &kp O &kp LC(S) &save_export &undo_twice &redo_twice

                // IMPORT | EXPORT | SPEED | KEYFRAME | AUDIO | FIT
                &kp LC(I) &kp LC(E) &kp LC(R) &kp LA(K) &kp LC(LS(S)) &kp LS(Z)

                // THUMBS
                &kp LC(S) &trans &kp SPACE
                &kp LC(LS(B)) &save_export &kp LC(E)
            >;
        };

        // =========================================================
        // LAYER 2 — CLIP
        // Работа с клипами и таймлайном
        // =========================================================

        raise_layer {
            display-name = "CLIP";

            bindings = <
                // SPEED | REVERSE | AUDIO | KEYFRAME | IN | OUT
                &kp LC(R) &kp LC(LA(R)) &kp LC(LS(S)) &kp LA(K) &kp I &kp O

                // LEFT | DOWN | UP | RIGHT | PLAY | MARKER
                &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp SPACE &kp M

                // MAGNET | SNAP | PREVIEW | ENABLE | NEXT MARK | PREV MARK
                &kp P &kp N &kp S &kp V &kp LS(M) &kp LA(LS(M))

                // SELECT | SPLIT | TRIM LEFT | TRIM RIGHT | DELETE | ESC
                &kp A &kp B &kp Q &kp W &kp DEL &kp ESC

                // ZOOM IN | ZOOM OUT | FIT | GROUP | UNGROUP | COMPOUND
                &kp LC(EQUAL) &kp LC(MINUS) &kp LS(Z) &kp LC(G) &kp LC(LS(G)) &kp LA(G)

                // UNDO COMPOUND | SPLIT ALL | PREV MARK | IMPORT | EXPORT | SAVE
                &kp LA(LS(G)) &kp LC(LS(B)) &kp LA(LS(M)) &kp LC(I) &kp LC(E) &kp LC(S)

                // THUMBS
                &kp LC(S) &trans &kp SPACE
                &kp LC(E) &trans &kp LC(I)
            >;
        };
    };
};
